{
  "name": "@launchnotes/mcp",
  "version": "0.1.0",
  "description": "MCP server for the LaunchNotes API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "launchnotes-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE", "USAGE.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "launchnotes",
    "model-context-protocol",
    "mcp-server",
    "claude",
