  ],
  "author": "LaunchNotes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchnotes/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/launchnotes/mcp/issues"
  },
  "homepage": "https://github.com/launchnotes/mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
